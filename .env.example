# =========================================================================
# Build-A-Politician: environment variables
#
# Copy this file to `.env.local` for local development:
#     cp .env.example .env.local
#
# .env.local is gitignored. NEVER commit a real key.
# On Vercel, set these in: Project -> Settings -> Environment Variables.
# =========================================================================

# REQUIRED for the AI analyst. Get one at https://platform.openai.com/api-keys
# Without it the site still works: it falls back to the built-in offline model.
OPENAI_API_KEY=sk-proj-replace-me

# OPTIONAL. Which OpenAI model to use. Defaults to gpt-4o-mini, which is
# cheap (fractions of a cent per simulation) and supports structured JSON output.
# OPENAI_MODEL=gpt-4o-mini

# OPTIONAL. Only needed if the front end is hosted somewhere OTHER than the
# same domain as this API: for example if the pages stay on GitHub Pages
# and only the API lives on Vercel. Set it to the exact site origin.
# ALLOWED_ORIGIN=https://bap.tpvan.com
